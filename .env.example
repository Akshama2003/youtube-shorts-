# ============ REQUIRED ============
# ============ AI BRAIN (choose ONE) ============
# FREE option: Google Gemini. Get a key (no card) at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Paid option: Anthropic Claude (needs credits) -> https://console.anthropic.com
# ANTHROPIC_API_KEY is used if LLM_PROVIDER=anthropic (or if Gemini key is empty)
# LLM_PROVIDER = gemini | anthropic   (empty = auto: Gemini if only a Gemini key is set)
LLM_PROVIDER=gemini

# https://console.anthropic.com  -> API Keys
ANTHROPIC_API_KEY=
# Stock footage (free, royalty-free). Fill AT LEAST ONE; both = more variety.
# Pexels: https://www.pexels.com/api/  (key issuance may be paused - then use Pixabay)
PEXELS_API_KEY=
# Pixabay: https://pixabay.com/api/docs/  (free account -> key shown on that page)
PIXABAY_API_KEY=

# ============ CONTENT ============
# hi = Hindi (Devanagari) narration + subtitles, en = English
LANGUAGE=hi
# Country for Google Trends (IN, US, GB ...)
GEO=IN
# Optional: restrict topics, e.g. "science and technology"
NICHE=
CHANNEL_NAME=gametokhelo
TARGET_SECONDS=45
MAX_SECONDS=58

# ============ VOICE (free Microsoft Edge neural voices) ============
# Leave empty for default: hi-IN-SwaraNeural / en-IN-NeerjaNeural
# Others: hi-IN-MadhurNeural, en-US-AndrewNeural, en-GB-RyanNeural
VOICE=
VOICE_RATE=+0%

# ============ QA + PUBLISHING ============
# How many times the Writer may rewrite after QA rejects a video
MAX_REVISIONS=2
# true = upload automatically when QA passes
AUTO_PUBLISH=true
# private | unlisted | public   (start with private, switch to public once happy)
YT_PRIVACY=private
# true = mark video as "altered/synthetic content" + add AI note in description (recommended)
DISCLOSE_AI=true

# ============ ADVANCED ============
CLAUDE_MODEL=claude-sonnet-5-5
SUB_FONT=
FFMPEG=ffmpeg
FFPROBE=ffprobe
